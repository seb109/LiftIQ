# LiftIQ Environment Configuration Example
# Copy this file to .env and adjust values as needed.

# PostgreSQL Connection String
# Compatible with local PostgreSQL or Supabase PostgreSQL instance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liftiq

# Groq API Key for AI Coaching Reports (Optional for CV-only operation)
GROQ_API_KEY=your_groq_api_key_here
