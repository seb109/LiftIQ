# LiftIQ Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before running the application.
# NEVER commit .env to git — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (Docker Compose) ────────────────────────────────────────────────
# These three variables configure the PostgreSQL container started by compose.yaml.
# They are also used to construct DATABASE_URL inside compose.yaml.
POSTGRES_DB=liftiq_db
POSTGRES_USER=liftiq_user
POSTGRES_PASSWORD=liftiq_dev_password

# ── Database connection URL ────────────────────────────────────────────────────
# Inside Docker:  postgresql://liftiq_user:liftiq_dev_password@postgres:5432/liftiq_db
#   (use Docker-internal hostname 'postgres', not localhost)
# Direct local:   postgresql://postgres:postgres@localhost:5432/liftiq
#   (if running PostgreSQL directly on your machine without Docker)
# Via Docker host: postgresql://liftiq_user:liftiq_dev_password@localhost:5433/liftiq_db
#   (connect from a tool like pgAdmin to the Docker-mapped host port 5433)
DATABASE_URL=postgresql://liftiq_user:liftiq_dev_password@localhost:5433/liftiq_db

# ── Security ───────────────────────────────────────────────────────────────────
# REQUIRED — generate a unique secret for every deployment:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_a_real_secret_key_before_use

# ── AI Coaching ─────────────────────────────────────────────────────────────────
# Obtain from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── CORS / Frontend URL ─────────────────────────────────────────────────────────
# The public URL of the LiftIQ frontend — used to build the CORS allowlist.
# Local dev (Docker):  http://localhost:3001
# Production:          https://your-app.vercel.app
FRONTEND_URL=http://localhost:3001

# ── Frontend API URL (for docker compose build-arg) ────────────────────────────
# The browser-accessible backend URL.
# Local dev:   http://localhost:8000
# Production:  https://your-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Application ─────────────────────────────────────────────────────────────────
# Values: development | docker | production
ENVIRONMENT=development
LOG_LEVEL=INFO
