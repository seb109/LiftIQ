# ── LiftIQ Frontend Dockerfile ─────────────────────────────────────────────────
# Multi-stage build: deps → builder → runner
# NEXT_PUBLIC_API_URL must be supplied at build time (--build-arg) because
# Next.js inlines NEXT_PUBLIC_* variables at build time, not runtime.
# No secrets are baked into this image.

# ── Stage 1: Install dependencies ─────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# ci install is deterministic and faster than npm install in CI/Docker contexts.
RUN npm ci

# ── Stage 2: Build Next.js application ────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# NEXT_PUBLIC_API_URL is the browser-accessible backend URL.
# Default: http://localhost:8000 (local Docker stack).
# Production: set to https://your-api.onrender.com via --build-arg.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# output: 'standalone' in next.config.ts produces .next/standalone/server.js
RUN npm run build

# ── Stage 3: Production runner ────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
# Port 3001 — LiftIQ never uses 3000.
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

# Copy only the standalone bundle and static assets.
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3001

# server.js is generated by Next.js standalone output.
CMD ["node", "server.js"]
